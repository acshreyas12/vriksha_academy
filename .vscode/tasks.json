{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Run Full Stack (Frontend + Backend)",
      "dependsOn": [
        "▶ Run Backend (Spring Boot)",
        "▶ Run Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "▶ Run Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/Project1/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*dev.*",
          "endsPattern": ".*Local:.*http://localhost:.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      }
    },
    {
      "label": "▶ Run Backend (Spring Boot)",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/Project1/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting VrikshaAcademyApplication.*",
          "endsPattern": ".*Started VrikshaAcademyApplication in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      }
    },
    {
      "label": "▶ Run Backend (MySQL Profile)",
      "type": "shell",
      "command": "mvn spring-boot:run -Dspring-boot.run.profiles=mysql",
      "options": {
        "cwd": "${workspaceFolder}/Project1/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting VrikshaAcademyApplication.*",
          "endsPattern": ".*Started VrikshaAcademyApplication in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      }
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/Project1/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Backend (Maven)",
      "type": "shell",
      "command": "mvn clean package -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}/Project1/backend"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Frontend (Vite)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/Project1/frontend"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}